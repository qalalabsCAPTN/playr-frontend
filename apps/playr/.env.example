# NECTAR Multi-Brand Routing
NEXT_PUBLIC_TENANT_ID=playr

# Client-Safe Variables (Exposed to Browser)
NEXT_PUBLIC_NECTAR_BFF_URL=https://shop.playr.com/api/v1
NEXT_PUBLIC_RAZORPAY_KEY=rzp_live_example123
NEXT_PUBLIC_CCAVENUE_KEY=ccav_live_merchant_key
NEXT_PUBLIC_ANALYTICS_WRITE_KEY=analytics_token_prod_999
NEXT_PUBLIC_AUTH_DOMAIN=auth.nectar.commerce.example.com
NEXT_PUBLIC_AUTH_CLIENT_ID=client_auth_example123

# Server-Only Variables (NECTAR Microservices - NEVER use NEXT_PUBLIC)
NECTAR_CORE_API_URL=https://internal.api.nectar.commerce/v1
WALLET_API_URL=https://internal.wallet.nectar.commerce/v1
REWARDS_API_URL=https://internal.rewards.nectar.commerce/v1
LOGISTICS_API_URL=https://internal.logistics.nectar.commerce/v1
CMS_GRAPHQL_ENDPOINT=https://internal.cms.nectar.commerce/graphql

# Server-Only Secrets
AUTH_SECRET=generate_a_secure_random_string_for_production
CCAVENUE_ACCESS_CODE=ccav_live_access_code
CMS_PREVIEW_TOKEN=secret_cms_preview_token
